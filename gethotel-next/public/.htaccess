# ═══════════════════════════════════════════════
# SECURITY HEADERS & HARDENING
# ═══════════════════════════════════════════════
# Disable directory browsing
Options -Indexes

# Block sensitive files from public access (.env, .git, .lock, .sql, etc.)
<FilesMatch "^\.(.*)|(\.env|\.git|\.lock|\.sql|\.bak|\.log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Security HTTP response headers
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME type sniffing
    Header always set X-Content-Type-Options "nosniff"
    
    # Enable browser XSS filtering
    Header always set X-XSS-Protection "1; mode=block"
    
    # Control referrer information passed to other sites
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # Enforce HTTPS via HSTS (1 year)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Restrict permissions/features
    Header always set Permissions-Policy "camera=(), microphone=(), payment=(self 'https://checkout.razorpay.com')"
    
    # Remove server banner if possible
    Header unset X-Powered-By
</IfModule>

# ═══════════════════════════════════════════════
# GZIP/DEFLATE COMPRESSION (Improves load speed)
# ═══════════════════════════════════════════════
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/x-font-otf
    AddOutputFilterByType DEFLATE application/x-font-truetype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# ═══════════════════════════════════════════════
# LEVERAGE BROWSER CACHING (Saves bandwidth & load time)
# ═══════════════════════════════════════════════
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images (Cache for 1 year)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS, JavaScript (Cache for 1 year)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Fonts (Cache for 1 year)
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # HTML (Check for changes every time)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

DirectoryIndex index.html

# ═══════════════════════════════════════════════
# NEXT.JS CLEAN ROUTING FOR CPANEL & LITESPEED
# ═══════════════════════════════════════════════
RewriteEngine On
RewriteBase /

# 1. Bypass API routes and existing physical files/directories
RewriteCond %{REQUEST_URI} ^/api [NC]
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Dynamic Next.js Catch-alls
RewriteRule ^hotel/.*$ /hotel/1/index.html [L,QSA]
RewriteRule ^booking/.*$ /booking/details/1/index.html [L,QSA]
RewriteRule ^bookings/.*$ /bookings/details/1/index.html [L,QSA]
RewriteRule ^packages/.*$ /packages/1/index.html [L,QSA]
RewriteRule ^tour-packages/.*$ /tour-packages/1/index.html [L,QSA]
RewriteRule ^hotels-in/([^/]+)/([^/]+)/?$ /hotels-in/$1/$2/index.html [L,QSA]
RewriteRule ^hotels-in/([^/]+)/?$ /hotels-in/$1/index.html [L,QSA]
RewriteRule ^hotels/delhi/([^/]+)/?$ /hotels/delhi/$1/index.html [L,QSA]


# 2.5 Canonical Redirects for Legacy / Alternative URL Variations
RewriteRule ^hotels-in-delhi/?$ /delhi-hotels [R=301,L]
RewriteRule ^terms-&-conditions/?$ /terms-of-service [R=301,L]
RewriteRule ^terms/?$ /terms-of-service [R=301,L]
RewriteRule ^terms-of-service-&-conditions/?$ /terms-of-service [R=301,L]

# 3. Multilingual /en/ 301 Redirects to Root (Enforce Canonical)
RewriteRule ^(en|hi|es|fr|de|zh|ja|ar|ru|pt|bn|ta|te|mr|gu|kn|ml|pa|ur)/?$ / [R=301,L]
RewriteRule ^(en|hi|es|fr|de|zh|ja|ar|ru|pt|bn|ta|te|mr|gu|kn|ml|pa|ur)/(.*)$ /$2 [R=301,L]

# 4. Folder index.html resolution
RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
RewriteRule ^(.*?)/?$ /$1/index.html [L,QSA]

# 5. Clean HTML Pages resolution
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*?)/?$ /$1.html [L,QSA]

# 6. Fallback to index.html for Client Routing
RewriteRule . /index.html [L]
