# ═══════════════════════════════════════════════
# GZIP/DEFLATE COMPRESSION (Improves load speed)
# ═══════════════════════════════════════════════
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/vnd.ms-fontobject
    AddOutputFilterByType DEFLATE application/x-font
    AddOutputFilterByType DEFLATE application/x-font-opentype
    AddOutputFilterByType DEFLATE application/x-font-otf
    AddOutputFilterByType DEFLATE application/x-font-truetype
    AddOutputFilterByType DEFLATE application/x-font-ttf
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE font/opentype
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# ═══════════════════════════════════════════════
# LEVERAGE BROWSER CACHING (Saves bandwidth & load time)
# ═══════════════════════════════════════════════
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images (Cache for 1 year)
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS, JavaScript (Cache for 1 year)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Fonts (Cache for 1 year)
    ExpiresByType font/opentype "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    
    # HTML (Check for changes every time)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ═══════════════════════════════════════════════
# NEXT.JS MULTILINGUAL & CLEAN ROUTING FOR CPANEL
# ═══════════════════════════════════════════════
RewriteEngine On
RewriteBase /

# 1. Bypass API routes and existing physical files/directories
RewriteCond %{REQUEST_URI} ^/api [NC]
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 2. Language Root URLs (e.g. /en, /hi, /es, etc. -> /index.html)
RewriteRule ^(en|hi|es|fr|de|zh|ja|ar|ru|pt|bn|ta|te|mr|gu|kn|ml|pa|ur)/?$ /index.html [L,QSA]

# 3. Dynamic Next.js Routes with language prefix
RewriteRule ^(en|hi|es|fr|de|zh|ja|ar|ru|pt|bn|ta|te|mr|gu|kn|ml|pa|ur)?/?hotel/.*$ /hotel/1.html [L,QSA]
RewriteRule ^(en|hi|es|fr|de|zh|ja|ar|ru|pt|bn|ta|te|mr|gu|kn|ml|pa|ur)?/?booking/.*$ /booking/details/1.html [L,QSA]
RewriteRule ^(en|hi|es|fr|de|zh|ja|ar|ru|pt|bn|ta|te|mr|gu|kn|ml|pa|ur)?/?tour-packages/.*$ /tour-packages/1.html [L,QSA]
RewriteRule ^(en|hi|es|fr|de|zh|ja|ar|ru|pt|bn|ta|te|mr|gu|kn|ml|pa|ur)?/?admin/.*$ /admin/dashboard.html [L,QSA]
RewriteRule ^(en|hi|es|fr|de|zh|ja|ar|ru|pt|bn|ta|te|mr|gu|kn|ml|pa|ur)?/?partner-dashboard/.*$ /partner-dashboard/dashboard.html [L,QSA]

# 4. Multilingual Static HTML Pages (e.g. /en/hotels -> /hotels.html, /en/delhi-hotels -> /delhi-hotels.html)
RewriteCond %{DOCUMENT_ROOT}/$2.html -f
RewriteRule ^(en|hi|es|fr|de|zh|ja|ar|ru|pt|bn|ta|te|mr|gu|kn|ml|pa|ur)/(.*)$ /$2.html [L,QSA]

# 5. Non-prefixed Clean HTML Pages (e.g. /hotels -> /hotels.html)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.*)$ /$1.html [L,QSA]

# 6. Fallback to index.html for Client Routing
RewriteRule . /index.html [L]
