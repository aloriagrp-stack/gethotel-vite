generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model booking {
  id                 Int           @id @default(autoincrement())
  userId             Int
  hotelId            Int
  roomId             Int
  checkIn            DateTime
  checkOut           DateTime
  totalPrice         Float
  totalGuests        Int
  status             String        @default("held")
  paymentStatus      String        @default("pending")
  amountPaid         Float         @default(0)
  razorpayOrderId    String?       @unique(map: "Booking_razorpayOrderId_key")
  razorpayPaymentId  String?       @unique(map: "Booking_razorpayPaymentId_key")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  companyName        String?
  gstNumber          String?
  guestEmail         String        @default("")
  guestFirstName     String        @default("")
  guestLastName      String        @default("")
  guestPhone         String        @default("")
  isBusiness         Boolean       @default(false)
  roomDetails        String?       @db.Text
  specialRequests    String?       @db.Text
  holdExpiresAt      DateTime?
  razorpaySignature  String?       @db.Text
  cancellationReason String?       @db.Text
  internalNotes      String?       @db.Text
  hotel              hotel         @relation(fields: [hotelId], references: [id], onDelete: Cascade, map: "Booking_hotelId_fkey")
  room               room          @relation(fields: [roomId], references: [id], onDelete: Cascade, map: "Booking_roomId_fkey")
  user               user          @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Booking_userId_fkey")
  transactions       transaction[]

  @@index([hotelId], map: "Booking_hotelId_fkey")
  @@index([roomId], map: "Booking_roomId_fkey")
  @@index([userId], map: "Booking_userId_fkey")
}

model transaction {
  id               Int      @id @default(autoincrement())
  bookingId        Int
  amount           Float
  currency         String   @default("INR")
  status           String
  gateway          String   @default("razorpay")
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?  @db.Text
  rawResponse      String?  @db.LongText
  createdAt        DateTime @default(now())
  booking          booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model coupon {
  id             Int      @id @default(autoincrement())
  code           String   @unique(map: "Coupon_code_key")
  discountType   String   @default("percentage")
  discountValue  Float
  minBookingAmt  Float    @default(0)
  maxDiscount    Float?
  startDate      DateTime
  endDate        DateTime
  usageLimit     Int?
  usedCount      Int      @default(0)
  isActive       Boolean  @default(true)
  hotelId        Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Advanced coupon fields
  promoType      String   @default("standard")
  minStay        Int      @default(1)
  targetAudience String   @default("all")
  applyToRooms   String   @default("all") @db.Text

  hotel          hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade, map: "Coupon_hotelId_fkey")

  @@index([hotelId], map: "Coupon_hotelId_fkey")
}

model dailyrate {
  id        Int      @id @default(autoincrement())
  date      DateTime
  price     Float
  available Int      @default(1)
  roomId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      room     @relation(fields: [roomId], references: [id], onDelete: Cascade, map: "DailyRate_roomId_fkey")

  @@unique([roomId, date], map: "DailyRate_roomId_date_key")
}

model hotel {
  id                    Int            @id @default(autoincrement())
  name                  String
  tagline               String?
  description           String         @db.Text
  city                  String
  address               String
  pricePerNight         Float
  starRating            Int            @default(3)
  guestRating           Float          @default(0)
  reviewCount           Int            @default(0)
  thumbnail             String?        @db.LongText
  images                String?        @db.LongText
  amenities             String?        @db.LongText
  isFeatured            Boolean        @default(false)
  isTrending            Boolean        @default(false)
  dining                String?        @db.LongText
  wellness              String?        @db.LongText
  faqs                  String?        @db.LongText
  safety                String?        @db.LongText
  policies              String?        @db.LongText
  mainAmenities         String?        @db.LongText
  userId                Int
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  hotelUsername         String?        @unique(map: "Hotel_hotelUsername_key")
  badges                String?        @db.Text
  bookingAcceptanceRate Float          @default(100)
  cancellationRate      Float          @default(0)
  complaintsCount       Int            @default(0)
  noShowRate            Float          @default(0)
  qualityScore          Float          @default(85)
  responseSpeed         String?        @default("Fast")
  isActive              Boolean        @default(true)
  otaApiKey             String?        @unique(map: "Hotel_otaApiKey_key")
  otaEnabled            Boolean        @default(false)
  booking               booking[]
  coupon                coupon[]
  user                  user           @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Hotel_userId_fkey")
  hotelwallet           hotelwallet?
  notification          notification[]
  payouts               payout[]
  review                review[]
  room                  room[]
  staff                 staff[]

  @@index([userId], map: "Hotel_userId_fkey")
}

model notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  hotelId   Int?
  title     String
  message   String   @db.Text
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  hotel     hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade, map: "Notification_hotelId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Notification_userId_fkey")

  @@index([hotelId], map: "Notification_hotelId_fkey")
  @@index([userId], map: "Notification_userId_fkey")
}

model partnerrequest {
  id              Int      @id @default(autoincrement())
  hotelName       String
  tagline         String?
  description     String   @db.Text
  address         String
  city            String
  pricePerNight   Float
  userName        String
  userEmail       String
  userPhone       String
  partnerPassword String
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hotelUsername   String?
}

model review {
  id            Int      @id @default(autoincrement())
  userId        Int
  hotelId       Int
  rating        Int
  comment       String?  @db.Text
  createdAt     DateTime @default(now())
  cleanliness   Int      @default(5)
  comfort       Int      @default(5)
  location      Int      @default(5)
  partnerReply  String?  @db.Text
  staff         Int      @default(5)
  valueForMoney Int      @default(5)
  hotel         hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, map: "Review_hotelId_fkey")
  user          user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Review_userId_fkey")

  @@unique([userId, hotelId], map: "Review_userId_hotelId_key")
  @@index([hotelId], map: "Review_hotelId_fkey")
}

model room {
  id               Int         @id @default(autoincrement())
  name             String
  bedConfiguration String?
  sizeM2           Int?
  maxOccupancy     Int         @default(2)
  pricePerNight    Float
  amenities        String?     @db.LongText
  images           String?     @db.LongText
  highlights       String?     @db.LongText
  trustPoints      String?     @db.LongText
  hotelId          Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  description      String?     @db.Text
  
  // 1. Status & Visibility
  status           String      @default("active") // active, inactive, draft, maintenance
  
  // 2. Inventory Management
  totalInventory   Int         @default(1)
  
  // 3. View & Location
  viewType         String?     // City, Sea, Mountain, Garden
  floorNumber      Int?
  isCornerRoom     Boolean     @default(false)
  
  // 4. Advanced Occupancy
  capacityAdults   Int         @default(2)
  capacityChildren Int         @default(0)
  capacityInfants  Int         @default(0)
  extraMattress    Boolean     @default(false)
  extraBedCharge   Float       @default(0)
  
  // 5. Tags & Badges
  tags             String?     @db.Text // JSON string for badges: Couple Friendly, Best Seller, etc.
  
  // 6. Priority
  isFeatured       Boolean     @default(false)
  displayPriority  Int         @default(0)
  
  // 7. Advanced Media
  videoUrl         String?     @db.Text
  media360Url      String?     @db.Text
  
  // 8. Availability Rules
  minStay          Int         @default(1)
  maxStay          Int         @default(90)
  isInstantBooking Boolean     @default(true)
  advanceBookingDays Int       @default(0)
  
  // 9. Payment & Pricing
  advancePayment   Int         @default(0)
  securityDeposit  Float       @default(0)
  isRefundable     Boolean     @default(true)
  isTaxIncluded    Boolean     @default(false)
  weekendPricing   String?     @db.Text // JSON
  seasonalPricing  String?     @db.Text // JSON
  
  // 10. Add-ons
  addOns           String?     @db.Text // JSON: Breakfast, Airport Pickup, etc.
  
  // 11. Restrictions
  petsAllowed      Boolean     @default(false)
  smokingAllowed   Boolean     @default(false)
  alcoholAllowed   Boolean     @default(true)
  partyAllowed     Boolean     @default(false)
  
  // 15. SEO
  seoTitle         String?
  seoDescription   String?     @db.Text
  slug             String?     @unique
  
  // Legacy / Existing fields
  roomPolicies    String?     @db.Text
  minPrice        Float       @default(0)
  maxPrice        Float       @default(0)
  weeklyDiscount  Int         @default(0)
  monthlyDiscount Int         @default(0)
  variants        String?     @db.LongText
  isHourlyEnabled Boolean     @default(false)
  hourlyRates     String?     @db.LongText
  
  booking          booking[]
  dailyrate        dailyrate[]
  hotel           hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade, map: "Room_hotelId_fkey")

  @@index([hotelId], map: "Room_hotelId_fkey")
}

model staff {
  id        Int      @id @default(autoincrement())
  userId    Int
  hotelId   Int
  role      String   @default("receptionist")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotel     hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade, map: "Staff_hotelId_fkey")
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "Staff_userId_fkey")

  @@unique([userId, hotelId], map: "Staff_userId_hotelId_key")
  @@index([hotelId], map: "Staff_hotelId_fkey")
}

model user {
  id                    Int            @id @default(autoincrement())
  name                  String
  email                 String         @unique(map: "User_email_key")
  password              String
  role                  String         @default("user")
  nameLastChangedAt     DateTime?
  profileImage          String?        @db.LongText
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  
  // Password tracking columns
  passwordLastChangedAt DateTime?
  passwordChangeHistory String?        @db.Text

  // Email tracking columns
  emailChangeHistory    String?        @db.Text

  booking               booking[]
  hotel                 hotel[]
  notification          notification[]
  review                review[]
  staff                 staff[]
}

model payout {
  id            Int       @id @default(autoincrement())
  hotelId       Int
  amount        Float
  status        String    @default("pending")
  bankReference String?
  payoutDate    DateTime?
  createdAt     DateTime  @default(now())
  hotel         hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}

model hotelwallet {
  id               Int       @id @default(autoincrement())
  hotelId          Int       @unique(map: "hotelWallet_hotelId_key")
  totalRevenue     Float     @default(0)
  availableBalance Float     @default(0)
  pendingPayouts   Float     @default(0)
  commissionRate   Float     @default(15)
  lastPayoutDate   DateTime?
  updatedAt        DateTime
  hotel            hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade, map: "hotelWallet_hotelId_fkey")
}

model visitor_log {
  id        Int      @id @default(autoincrement())
  ip        String   @db.VarChar(64)
  country   String?  @db.VarChar(100)
  region    String?  @db.VarChar(100)
  city      String?  @db.VarChar(100)
  page      String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([country])
}

model homepage_config {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @db.LongText
  updatedAt DateTime @updatedAt
}
