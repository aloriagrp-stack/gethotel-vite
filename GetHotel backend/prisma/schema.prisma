generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model booking {
  id                Int      @id @default(autoincrement())
  userId            Int
  hotelId           Int
  roomId            Int
  guestFirstName    String   @default("")
  guestLastName     String   @default("")
  guestEmail        String   @default("")
  guestPhone        String   @default("")
  specialRequests   String?  @db.Text
  isBusiness        Boolean  @default(false)
  gstNumber         String?
  companyName       String?
  roomDetails       String?  @db.Text // JSON string of selected rooms & quantities
  checkIn           DateTime
  checkOut          DateTime
  totalPrice        Float
  totalGuests       Int
  status            String   @default("held") // held, confirmed, checked-in, checked-out, cancelled, refunded, failed
  paymentStatus     String   @default("pending") // pending, paid, failed, refunded, partially_refunded
  amountPaid        Float    @default(0)
  razorpayOrderId   String?  @unique(map: "Booking_razorpayOrderId_key")
  razorpayPaymentId String?  @unique(map: "Booking_razorpayPaymentId_key")
  razorpaySignature String?  @db.Text
  holdExpiresAt     DateTime? // For 10-minute hold logic
  internalNotes     String?   @db.Text // Hotel staff notes
  cancellationReason String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  hotel             hotel    @relation(fields: [hotelId], references: [id], map: "Booking_hotelId_fkey")
  room              room     @relation(fields: [roomId], references: [id], map: "Booking_roomId_fkey")
  user              user     @relation(fields: [userId], references: [id], map: "Booking_userId_fkey")
  transactions      transaction[]

  @@index([hotelId], map: "Booking_hotelId_fkey")
  @@index([roomId], map: "Booking_roomId_fkey")
  @@index([userId], map: "Booking_userId_fkey")
}

model transaction {
  id                Int      @id @default(autoincrement())
  bookingId         Int
  amount            Float
  currency          String   @default("INR")
  status            String   // pending, success, failed
  gateway           String   @default("razorpay")
  gatewayOrderId    String?
  gatewayPaymentId  String?
  gatewaySignature  String?  @db.Text
  rawResponse       String?  @db.LongText // Log everything for debugging
  createdAt         DateTime @default(now())
  booking           booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model coupon {
  id            Int      @id @default(autoincrement())
  code          String   @unique(map: "Coupon_code_key")
  discountType  String   @default("percentage")
  discountValue Float
  minBookingAmt Float    @default(0)
  maxDiscount   Float?
  startDate     DateTime
  endDate       DateTime
  usageLimit    Int?
  usedCount     Int      @default(0)
  isActive      Boolean  @default(true)
  hotelId       Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  hotel         hotel?   @relation(fields: [hotelId], references: [id], onDelete: Cascade, map: "Coupon_hotelId_fkey")

  @@index([hotelId], map: "Coupon_hotelId_fkey")
}

model dailyrate {
  id        Int      @id @default(autoincrement())
  date      DateTime
  price     Float
  available Int      @default(1)
  roomId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  room      room     @relation(fields: [roomId], references: [id], onDelete: Cascade, map: "DailyRate_roomId_fkey")

  @@unique([roomId, date], map: "DailyRate_roomId_date_key")
}

model hotel {
  id            Int            @id @default(autoincrement())
  name          String
  tagline       String?
  description   String         @db.Text
  city          String
  address       String
  pricePerNight Float
  starRating    Int            @default(3)
  guestRating   Float          @default(0)
  reviewCount   Int            @default(0)
  thumbnail     String?        @db.LongText
  images        String?        @db.LongText
  amenities     String?        @db.LongText
  isFeatured    Boolean        @default(false)
  isTrending    Boolean        @default(false)
  dining        String?        @db.LongText
  wellness      String?        @db.LongText
  faqs          String?        @db.LongText
  safety        String?        @db.LongText
  policies      String?        @db.LongText
  userId        Int
  qualityScore  Float          @default(85.0) // 0-100 Performance Score
  cancellationRate Float       @default(0)    // Percentage
  responseSpeed String?        @default("Fast") // "Fast", "Instant", "Within hour"
  noShowRate    Float          @default(0)    // Percentage
  bookingAcceptanceRate Float  @default(100)  // Percentage
  complaintsCount Int          @default(0)
  badges        String?        @db.Text       // JSON or comma-separated: "Trusted Partner", "Top Selling"
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  hotelUsername String?        @unique(map: "Hotel_hotelUsername_key")
  booking       booking[]
  coupon        coupon[]
  user          user           @relation(fields: [userId], references: [id], map: "Hotel_userId_fkey")
  notification  notification[]
  review        review[]
  room          room[]
  staff         staff[]
  wallet        hotelWallet?
  payouts       payout[]
  message       message[]

  @@index([userId], map: "Hotel_userId_fkey")
}

model notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  hotelId   Int?
  title     String
  message   String   @db.Text
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  hotel     hotel?   @relation(fields: [hotelId], references: [id], map: "Notification_hotelId_fkey")
  user      user     @relation(fields: [userId], references: [id], map: "Notification_userId_fkey")

  @@index([hotelId], map: "Notification_hotelId_fkey")
  @@index([userId], map: "Notification_userId_fkey")
}

model partnerrequest {
  id              Int      @id @default(autoincrement())
  hotelName       String
  tagline         String?
  description     String   @db.Text
  address         String
  city            String
  pricePerNight   Float
  userName        String
  userEmail       String
  userPhone       String
  partnerPassword String
  status          String   @default("pending")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  hotelUsername   String?
}

model review {
  id               Int      @id @default(autoincrement())
  userId           Int
  hotelId          Int
  rating           Int      // Overall Average
  cleanliness      Int      @default(5)
  location         Int      @default(5)
  staff            Int      @default(5)
  comfort          Int      @default(5)
  valueForMoney    Int      @default(5)
  comment          String?  @db.Text
  partnerReply     String?  @db.Text
  createdAt        DateTime @default(now())
  hotel            hotel    @relation(fields: [hotelId], references: [id], map: "Review_hotelId_fkey")
  user             user     @relation(fields: [userId], references: [id], map: "Review_userId_fkey")

  @@unique([userId, hotelId], map: "Review_userId_hotelId_key")
  @@index([hotelId], map: "Review_hotelId_fkey")
}

model room {
  id               Int         @id @default(autoincrement())
  name             String
  bedConfiguration String?
  sizeM2           Int?
  maxOccupancy     Int         @default(2)
  pricePerNight    Float
  amenities        String?     @db.LongText
  images           String?     @db.LongText
  hotelId          Int
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  description      String?     @db.Text
  booking          booking[]
  dailyrate        dailyrate[]
  hotel            hotel       @relation(fields: [hotelId], references: [id], onDelete: Cascade, map: "Room_hotelId_fkey")

  @@index([hotelId], map: "Room_hotelId_fkey")
}

model staff {
  id        Int      @id @default(autoincrement())
  userId    Int
  hotelId   Int
  role      String   @default("receptionist")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hotel     hotel    @relation(fields: [hotelId], references: [id], map: "Staff_hotelId_fkey")
  user      user     @relation(fields: [userId], references: [id], map: "Staff_userId_fkey")

  @@unique([userId, hotelId], map: "Staff_userId_hotelId_key")
  @@index([hotelId], map: "Staff_hotelId_fkey")
}

model user {
  id                Int            @id @default(autoincrement())
  name              String
  email             String         @unique(map: "User_email_key")
  password          String
  role              String         @default("user")
  nameLastChangedAt DateTime?
  profileImage      String?        @db.LongText
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  booking           booking[]
  hotel             hotel[]
  notification      notification[]
  review            review[]
  staff             staff[]
  message           message[]
}

model hotelWallet {
  id              Int      @id @default(autoincrement())
  hotelId         Int      @unique
  totalRevenue    Float    @default(0)
  availableBalance Float   @default(0)
  pendingPayouts  Float    @default(0)
  commissionRate  Float    @default(15.0) // 15% Platform Commission
  lastPayoutDate  DateTime?
  updatedAt       DateTime @updatedAt
  hotel           hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
}

model payout {
  id              Int      @id @default(autoincrement())
  hotelId         Int
  amount          Float
  status          String   @default("pending") // pending, processed, failed
  bankReference   String?
  payoutDate      DateTime?
  createdAt       DateTime @default(now())
  hotel           hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)

  @@index([hotelId])
}
model message {
  id        Int      @id @default(autoincrement())
  userId    Int
  hotelId   Int
  sender    String   // "user" or "hotel"
  content   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  hotel     hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  user      user     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([hotelId])
  @@index([userId])
}
